# Logging
LOG_LEVEL=INFO
LOGS_DIR=logs
LOG_FILE_NAME=pipeline.log

# Ingestion & Recovery
BATCH_SIZE=32
MAX_FILE_SIZE_MB=500
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0
BACKOFF_FACTOR=2.0

# Ollama Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=60.0

# Storage Directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FAILED_DIR=data/failed
CHECKPOINT_DIR=checkpoints
OUTPUT_PREDICTIONS_DIR=output/predictions
OUTPUT_ANALYTICS_DIR=output/analytics
