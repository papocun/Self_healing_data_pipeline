# Logging
LOG_LEVEL=INFO
LOGS_DIR=logs
LOG_FILE_NAME=pipeline.log

# Ingestion & Recovery
BATCH_SIZE=32
MAX_FILE_SIZE_MB=500
RAW_FILE_PATTERN=*review*.*, *sample*.*
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0
BACKOFF_FACTOR=2.0

# Ollama Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60.0

# Storage Directories
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_FAILED_DIR=data/failed
CHECKPOINT_DIR=checkpoints
OUTPUT_PREDICTIONS_DIR=output/predictions
OUTPUT_ANALYTICS_DIR=output/analytics

# Apache Airflow Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3-python3.11
AIRFLOW_UID=50000
# Required. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Local-development defaults; change before exposing any port
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
_PIP_ADDITIONAL_REQUIREMENTS=ollama>=0.1.0 pandas>=2.0.0 pydantic>=2.0.0 pyarrow python-dotenv requests
